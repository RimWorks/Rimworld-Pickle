<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <!-- Without this the compiler runs in DocumentationMode.None and StyleCop silently skips
         every SA16xx rule, so the documentation rules below never fire. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.33.*" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="StyleCop.props" />
</Project>
