<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RimWorks.Pickle.Patches.Concord</AssemblyName>
    <RootNamespace>RimWorks.Pickle.Patches.Concord</RootNamespace>
    <OutDir>$(MSBuildProjectDirectory)\..\..\Concord\Assemblies\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GamecrateRefs)/*.dll" Condition="'$(HasGameRefs)' == 'true'"
               Exclude="$(GamecrateRefs)/System.*.dll;$(GamecrateRefs)/System.dll;$(GamecrateRefs)/Microsoft.*.dll;$(GamecrateRefs)/mscorlib.dll;$(GamecrateRefs)/netstandard.dll;$(GamecrateRefs)/WindowsBase.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(HasGameRefs)' == 'false'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Concord.Ref" Version="0.24.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private=false everywhere: the core assemblies ship once, in the root
         Assemblies folder. A second copy here would load the same types twice. -->
    <ProjectReference Include="..\Pickle\Pickle.csproj" Private="false" />
    <ProjectReference Include="..\Pickle.Core\Pickle.Core.csproj" Private="false" />
  </ItemGroup>
</Project>
