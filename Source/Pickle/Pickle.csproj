<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RimWorks.Pickle</AssemblyName>
    <RootNamespace>RimWorks.Pickle</RootNamespace>
    <OutDir>$(MSBuildProjectDirectory)\..\..\$(GameVersion)\Assemblies\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GamecrateRefs)/*.dll"
               Exclude="$(GamecrateRefs)/System.*.dll;$(GamecrateRefs)/System.dll;$(GamecrateRefs)/Microsoft.*.dll;$(GamecrateRefs)/mscorlib.dll;$(GamecrateRefs)/netstandard.dll;$(GamecrateRefs)/WindowsBase.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RimWorks.RimLogging" Version="3.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Gherkin" Version="42.0.*" />
    <PackageReference Include="Cucumber.CucumberExpressions" Version="20.1.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pickle.Core\Pickle.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built by `npm run build` in Dashboard/ and not committed. Conditional so a
         fresh checkout still builds; Dashboard.cs serves a "run npm run build"
         placeholder when the bundle is absent. -->
    <EmbeddedResource Include="..\..\Dashboard\dist\index.html" LogicalName="Pickle.Dashboard.html" Condition="Exists('..\..\Dashboard\dist\index.html')" />
    <EmbeddedResource Include="..\..\Dashboard\dist\report.html" LogicalName="Pickle.ReportTemplate.html" Condition="Exists('..\..\Dashboard\dist\report.html')" />
  </ItemGroup>
  <Target Name="ShipNetStandardFacade" AfterTargets="Build" Condition="'$(GameVersion)' == '1.5'">
    <PropertyGroup>
      <NetStandardFacade>$(MSBuildExtensionsPath)/Microsoft/Microsoft.NET.Build.Extensions/net461/lib/netstandard.dll</NetStandardFacade>
    </PropertyGroup>
    <Error Condition="!Exists('$(NetStandardFacade)')" Text="No netstandard 2.0 facade at $(NetStandardFacade). RimWorld 1.5 ships none, so Gherkin and Cucumber cannot load without it." />
    <Copy SourceFiles="$(NetStandardFacade)" DestinationFiles="$(OutDir)00netstandard.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
