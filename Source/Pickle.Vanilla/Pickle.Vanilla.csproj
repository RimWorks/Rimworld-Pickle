<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RimWorks.Pickle.Vanilla</AssemblyName>
    <RootNamespace>RimWorks.Pickle.Vanilla</RootNamespace>
    <OutDir>$(MSBuildProjectDirectory)\..\..\$(GameVersion)\Assemblies\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GamecrateRefs)/*.dll"
               Exclude="$(GamecrateRefs)/System.*.dll;$(GamecrateRefs)/System.dll;$(GamecrateRefs)/Microsoft.*.dll;$(GamecrateRefs)/mscorlib.dll;$(GamecrateRefs)/netstandard.dll;$(GamecrateRefs)/WindowsBase.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(HarmonyDir)/0Harmony.dll" Private="False" Condition="'$(HarmonyLocal)' == 'true'" />
    <PackageReference Include="Lib.Harmony" Version="3.0.*-*" ExcludeAssets="runtime" PrivateAssets="all" Condition="'$(HarmonyLocal)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pickle\Pickle.csproj" />
  </ItemGroup>
</Project>
