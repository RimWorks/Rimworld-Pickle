<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RimWorks.Pickle.Core</AssemblyName>
    <RootNamespace>RimWorks.Pickle.Core</RootNamespace>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <!-- CA1875 wants Regex.Count and CA1510 wants ArgumentNullException.ThrowIfNull. The net472
         build the mod ships has neither. -->
    <NoWarn Condition="'$(TargetFramework)' != 'net472'">$(NoWarn);CA1875;CA1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="all" />
    <PackageReference Include="Gherkin" Version="42.0.*" />
    <PackageReference Include="Cucumber.CucumberExpressions" Version="20.1.*" />
  </ItemGroup>
</Project>
