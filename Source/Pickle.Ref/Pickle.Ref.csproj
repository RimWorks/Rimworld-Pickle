<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PackageId>RimWorks.Pickle.Ref</PackageId>
    <Version>0.1.0</Version>
    <Authors>RimWorks</Authors>
    <Description>Compile-time reference assembly for Pickle, the in-game BDD test runner for RimWorld. Reference this to build a steps dll; the Pickle mod supplies the real assembly at runtime.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RimWorks/Rimworld-Pickle</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Metadata only. The package ships Pickle's reference assembly, not this
         project's own (empty) output, so mono binds the mod's real dll at runtime. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
  </ItemGroup>

  <!-- Build Pickle first so its ref assembly exists, but do not reference it. -->
  <ItemGroup>
    <ProjectReference Include="..\Pickle\Pickle.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />

    <!-- ref/, not lib/: assets under ref are compile-only, so a consumer never
         copies this stub next to the real Pickle.dll the mod loads. -->
    <None Include="..\Pickle\obj\$(Configuration)\ref\Pickle.dll" Pack="true" PackagePath="ref/net472/" Visible="false" />
    <None Include="_._" Pack="true" PackagePath="lib/net472/" Visible="false" Condition="Exists('_._')" />
  </ItemGroup>
</Project>
