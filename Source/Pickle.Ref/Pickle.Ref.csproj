<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(GameTfm)</TargetFramework>
    <PackageId>RimWorks.Pickle.Ref</PackageId>
    <Version>0.1.0</Version>
    <Authors>RimWorks</Authors>
    <Description>Compile-time reference assemblies for Pickle, the in-game BDD test runner for RimWorld. Reference this to build a steps dll; the Pickle mod supplies the real assemblies at runtime.</Description>
    <PackageTags>rimworld;testing;bdd;gherkin;cucumber;integration-testing;modding</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RimWorks/Rimworld-Pickle</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Metadata only. The package ships Pickle's reference assembly, not this
         project's own (empty) output, so mono binds the mod's real dll at runtime. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5131 wants a <references> group, which only a hand written nuspec can carry.
         Without one a consumer references every assembly under ref/, which is the one we ship. -->
    <NoWarn>$(NoWarn);NU5128;NU5131</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Build Pickle first so its ref assembly exists, but do not reference it. -->
  <ItemGroup>
    <ProjectReference Include="..\Pickle\Pickle.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Pickle.Host.RimWorld\Pickle.Host.RimWorld.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <RefStash>$(MSBuildProjectDirectory)\obj\$(Configuration)\refpack\</RefStash>
  </PropertyGroup>

  <ItemGroup>
    <RefPair Include="..\Pickle\obj\$(Configuration)\ref\RimWorks.Pickle.dll" />
    <RefPair Include="..\Pickle.Host.RimWorld\obj\$(Configuration)\ref\RimWorks.Pickle.Host.RimWorld.dll" />
    <RefPacked Include="$(RefStash)net472\RimWorks.Pickle.dll;$(RefStash)net472\RimWorks.Pickle.Host.RimWorld.dll" PackagePath="ref/net472/" />
    <RefPacked Include="$(RefStash)net10.0\RimWorks.Pickle.dll;$(RefStash)net10.0\RimWorks.Pickle.Host.RimWorld.dll" PackagePath="ref/net10.0/" />
  </ItemGroup>

  <Target Name="StashRefPair" AfterTargets="Build" Condition="'$(GameVersion)' == '1.6' Or '$(GameVersion)' == '1.7'">
    <Copy SourceFiles="@(RefPair)" DestinationFolder="$(RefStash)$(GameTfm)" />
  </Target>

  <Target Name="RequireRefPairs" BeforeTargets="_GetPackageFiles" Condition="'$(RequireBothRefPairs)' == 'true'">
    <Error Condition="!Exists('%(RefPacked.Identity)')" Text="no %(RefPacked.Identity). build -c $(Configuration) with -p:GameVersion=1.6 and with -p:GameVersion=1.7 before the pack." />
  </Target>

  <Target Name="PackRefPairs" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="@(RefPacked)" Pack="true" Visible="false" Condition="Exists('%(RefPacked.Identity)')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="_._" Pack="true" PackagePath="lib/net472/;lib/net10.0/" Visible="false" Condition="Exists('_._')" />
  </ItemGroup>
</Project>
