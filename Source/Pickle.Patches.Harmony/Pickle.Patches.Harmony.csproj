<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RimWorks.Pickle.Patches.Harmony</AssemblyName>
    <RootNamespace>RimWorks.Pickle.Patches.Harmony</RootNamespace>
    <OutDir>$(MSBuildProjectDirectory)\..\..\$(GameVersion)\Harmony\Assemblies\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GamecrateRefs)/*.dll"
               Exclude="$(GamecrateRefs)/System.*.dll;$(GamecrateRefs)/System.dll;$(GamecrateRefs)/Microsoft.*.dll;$(GamecrateRefs)/mscorlib.dll;$(GamecrateRefs)/netstandard.dll;$(GamecrateRefs)/WindowsBase.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
        <!-- Harmony 3 is not on NuGet yet, so this is a local build of the upstream v3 branch. -->
    <Reference Include="$(HarmonyDir)/0Harmony.dll" Private="False" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private=false everywhere: the core assemblies ship once, in the version
         Assemblies folder. A second copy here would load the same types twice. -->
    <ProjectReference Include="..\Pickle\Pickle.csproj" Private="false" />
    <ProjectReference Include="..\Pickle.Core\Pickle.Core.csproj" Private="false" />
  </ItemGroup>
</Project>
