<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- CS1591 is the compiler's copy of SA1600 and ignores the .editorconfig path scoping
         that exempts test files, so it would demand docs the house convention says to skip. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.*" />
    <PackageReference Include="Gherkin" Version="42.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pickle.Core\Pickle.Core.csproj" />
  </ItemGroup>
</Project>
